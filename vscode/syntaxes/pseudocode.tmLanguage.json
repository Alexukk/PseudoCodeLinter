{
  "name": "Pseudocode",
  "scopeName": "source.psdc",
  "fileTypes": ["psdc"],
  "patterns": [
    { "include": "#shebang" },
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#function-definitions" },
    { "include": "#type-definitions" },
    { "include": "#modules" },
    { "include": "#control" },
    { "include": "#declarations" },
    { "include": "#primitive-types" },
    { "include": "#annotations" },
    { "include": "#bash-variables" },
    { "include": "#operators" },
    { "include": "#async" },
    { "include": "#memory-this" },
    { "include": "#builtin-functions" },
    { "include": "#constants" },
    { "include": "#member-access" },
    { "include": "#function-calls" },
    { "include": "#upper-constants" },
    { "include": "#types" },
    { "include": "#numbers" }
  ],
  "repository": {
    "shebang": {
      "name": "comment.line.shebang.psdc",
      "match": "^#!.*$"
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.psdc",
          "match": "//.*$"
        },
        {
          "name": "comment.line.number-sign.psdc",
          "match": "#.*$"
        },
        {
          "name": "comment.block.psdc",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.psdc",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            { "name": "constant.character.escape.psdc", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.psdc",
          "begin": "'",
          "end": "'|$",
          "patterns": [
            { "name": "constant.character.escape.psdc", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.template.psdc",
          "begin": "`",
          "end": "`|$",
          "patterns": [
            { "name": "constant.character.escape.psdc", "match": "\\\\." },
            {
              "name": "variable.other.interpolation.psdc",
              "match": "\\$\\{[^}]*\\}"
            }
          ]
        }
      ]
    },
    "function-definitions": {
      "match": "(?i)\\b(function|func|fn|def|proc|procedure|sub)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.function.psdc" },
        "2": { "name": "entity.name.function.psdc" }
      }
    },
    "type-definitions": {
      "match": "(?i)\\b(class|struct|interface|enum|trait|type|record)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.class.psdc" },
        "2": { "name": "entity.name.type.class.psdc" }
      }
    },
    "modules": {
      "patterns": [
        {
          "name": "keyword.control.import.psdc",
          "match": "(?i)\\b(import|export|from|include|require|package|pack|use|using|module|namespace|source|as)\\b"
        }
      ]
    },
    "control": {
      "patterns": [
        {
          "name": "keyword.control.psdc",
          "match": "(?i)\\b(if|then|else|elif|elseif|endif|fi|for|each|foreach|endfor|next|in|of|to|downto|step|while|endwhile|wend|until|repeat|loop|endloop|do|done|return|yield|break|continue|switch|case|endcase|esac|match|default|when|try|catch|except|finally|endtry|throw|raise|before|after|where|defer|guard|unless|select|begin|end|exit|goto|pass)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "storage.type.psdc",
          "match": "(?i)\\b(class|struct|interface|type|typedef|enum|trait|impl|fn|func|function|def|define|proc|procedure|sub|let|var|const|constant|val|set|mut|static|public|private|protected|internal|abstract|final|override|virtual|inline|declare|dim|global|local|readonly|extends|implements|inherits|returns)\\b"
        }
      ]
    },
    "primitive-types": {
      "patterns": [
        {
          "name": "storage.type.primitive.psdc",
          "match": "(?i)\\b(string|str|text|int|integer|char|character|bool|boolean|float|double|real|number|decimal|byte|long|short|void|u8|u16|u32|u64|i8|i16|i32|i64|f32|f64|usize|isize|any|object)\\b"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "entity.name.tag.psdc",
          "match": "@[a-zA-Z0-9_-]+"
        }
      ]
    },
    "bash-variables": {
      "patterns": [
        {
          "name": "variable.other.normal.psdc",
          "match": "\\$([a-zA-Z_][a-zA-Z0-9_]*|[0-9]+|\\?|@|#|\\*|\\$|!)"
        },
        {
          "name": "variable.other.bracket.psdc",
          "begin": "\\$\\{",
          "end": "\\}|$"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.psdc",
          "match": "(<-|->|=>|:=|←|→)"
        },
        {
          "name": "keyword.operator.comparison.psdc",
          "match": "(===|!==|==|!=|<>|<=|>=|<<|>>|<|>|≠|≤|≥)"
        },
        {
          "name": "keyword.operator.logical.psdc",
          "match": "(&&|\\|\\||!|\\b(?i:and|or|not|xor|is|instanceof|typeof|mod|div)\\b)"
        },
        {
          "name": "keyword.operator.assignment.psdc",
          "match": "(\\+=|-=|\\*=|/=|%=|=)"
        },
        {
          "name": "keyword.operator.arithmetic.psdc",
          "match": "(\\*\\*|\\+\\+|--|\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.bitwise.psdc",
          "match": "(\\||&|\\^|~)"
        }
      ]
    },
    "async": {
      "patterns": [
        {
          "name": "keyword.control.async.psdc",
          "match": "(?i)\\b(async|await|parallel|spawn|thread|go|chan|goroutine)\\b"
        }
      ]
    },
    "memory-this": {
      "patterns": [
        {
          "name": "variable.language.psdc",
          "match": "(?i)\\b(new|delete|alloc|free|make|len|sizeof|unsafe|ref|out|inout|self|this|super|base)\\b"
        }
      ]
    },
    "builtin-functions": {
      "patterns": [
        {
          "name": "support.function.builtin.psdc",
          "match": "(?i)\\b(print|printf|println|log|display|show|read|write|fetch|request|send|emit|echo|cat|grep|sed|awk|exec|eval|input|output|assert)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.psdc",
          "match": "\\b(?i:true|false|null|nil|none|undefined|nan|infinity)\\b"
        },
        {
          "name": "constant.language.psdc",
          "match": "\\b(Ok|Err|Some|SUCCESS|FAILURE|EXIT_SUCCESS|EXIT_FAILURE)\\b"
        }
      ]
    },
    "member-access": {
      "patterns": [
        {
          "match": "\\.([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.member.psdc" }
          }
        },
        {
          "match": "\\.([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "variable.other.property.psdc" }
          }
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.psdc" }
          }
        }
      ]
    },
    "upper-constants": {
      "patterns": [
        {
          "name": "constant.other.psdc",
          "match": "\\b[A-Z][A-Z0-9_]+\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.psdc",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.psdc",
          "match": "\\b(0[xX][0-9a-fA-F_]+|0[bB][01_]+|\\d[\\d_]*(\\.\\d+)?([eE][+-]?\\d+)?)\\b"
        }
      ]
    }
  }
}
